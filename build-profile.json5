{
  "app": {
    "signingConfigs": [],
    // 产品配置
    "products": [
      {
        "name": "default",

        "compatibleSdkVersion": "5.0.5(17)",
        // API 26 起版本号格式变更：直接写 API 级别（hvigor 校验规则，7.0.0(26) 格式会被拒绝）
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "externalNativeOptions": {
            "abiFilters": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      },
      {
        "name": "release",

        "compatibleSdkVersion": "5.0.5(17)",
        // API 26 起版本号格式变更：直接写 API 级别（hvigor 校验规则，7.0.0(26) 格式会被拒绝）
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "externalNativeOptions": {
            "abiFilters": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          // 入口模块的产品信息配置
          "applyToProducts": [
            "default",
            "release"
          ]
        }
      ]
    },
    {
      "name": "proxy_core",
      "srcPath": "./proxy_core",
    },
    {
      "name": "xb_components",
      "srcPath": "./xb_components"
    }
  ]
}